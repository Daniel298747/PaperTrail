# PaperTrail configuration. Copy to .env (git-ignored) and change the placeholder passwords.
# Docker Compose reads this file, and so does the backend when you run it locally with ./mvnw
# (application.yml imports ../.env). Real environment variables always take precedence.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=papertrail
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=change-me-postgres-password
# Used when the backend runs outside Docker against a PostgreSQL on localhost.
# (The Docker-free launcher, ./mvnw spring-boot:test-run, starts its own embedded database instead.)
DATABASE_URL=jdbc:postgresql://localhost:5432/papertrail
DATABASE_USERNAME=papertrail
DATABASE_PASSWORD=change-me-postgres-password

# ---------------------------------------------------------------- Object storage (S3 API)
# Local MinIO-compatible server (docker compose service "minio").
MINIO_ROOT_USER=papertrail
MINIO_ROOT_PASSWORD=change-me-storage-password
S3_BUCKET=papertrail-documents
S3_REGION=us-east-1
# How the backend reaches storage. Leave EMPTY for real AWS S3.
S3_ENDPOINT=http://localhost:9000
# Host embedded in signed download URLs; must be reachable from the browser. Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO needs path-style URLs; AWS S3 uses virtual-hosted style (false).
S3_PATH_STYLE_ACCESS=true
# Static keys for MinIO. Leave both EMPTY on AWS to use the default credential chain (IAM role, profile).
S3_ACCESS_KEY=papertrail
S3_SECRET_KEY=change-me-storage-password
# Create the bucket at startup if missing (local only; provision AWS buckets yourself).
S3_CREATE_BUCKET=true
# Lifetime of signed preview/download URLs (ISO-8601 duration).
S3_PRESIGN_TTL=PT5M

# ---------------------------------------------------------------- Authentication
# HS256 signing key for access tokens: base64, at least 32 bytes. Generate one with
#   openssl rand -base64 48
# Leave empty in development to use a random per-process key. Required when the prod profile is active.
APP_JWT_SECRET=
APP_JWT_ACCESS_TTL=PT15M
APP_REFRESH_TTL=P30D
# Refresh/CSRF cookies are Secure by default. Plain-http local development needs false.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
# Browser origins allowed to call the API cross-origin (comma-separated). The bundled setups are
# same-origin (Vite proxy, nginx), so this matters only for split deployments.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------- Jobs, uploads, demo
# Days ahead that recurring bills are created.
APP_RECURRING_HORIZON_DAYS=30
# Spring cron (UTC) for generation + reminders.
APP_JOBS_CRON=0 */15 * * * *
APP_UPLOAD_MAX_SIZE=10MB
# Set to true to (re)create the demo household on startup. Development only; refused with the prod profile.
APP_SEED_DEMO=false
